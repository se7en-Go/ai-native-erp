# ai-native-erp — production stack environment template.
#
#   cp .env.prod.example .env.prod      # .env.prod is git-ignored, never commit it
#   # fill in every REQUIRED value below, then:
#   docker compose -f infra/docker-compose.prod.yml --env-file .env.prod \
#     --profile demo-seed up -d --build
#
# Requires (fail-fast): POSTGRES_PASSWORD, APP_MIGRATOR_PASSWORD,
# APP_RUNTIME_PASSWORD, S3_ACCESS_KEY, S3_SECRET_KEY, MASTER_KEK_HEX,
# JWT_SECRET. `docker compose` refuses to start while any of them is empty.
#
# Generate strong values (copy/paste, macOS + Linux):
#   openssl rand -hex 24   # -> POSTGRES_PASSWORD / APP_MIGRATOR_PASSWORD / APP_RUNTIME_PASSWORD / S3_SECRET_KEY
#   openssl rand -hex 32   # -> MASTER_KEK_HEX (exactly 64 hex chars = 32 bytes)
#   openssl rand -hex 48   # -> JWT_SECRET
#
# Keep passwords hex-only: APP_RUNTIME_PASSWORD is embedded in the PgBouncer
# DATABASE_URL, where # @ / : would break URL parsing.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Postgres / PgBouncer
# ---------------------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_DB=erp_saas
# REQUIRED
POSTGRES_PASSWORD=
APP_MIGRATOR_USER=app_migrator
# REQUIRED
APP_MIGRATOR_PASSWORD=
APP_RUNTIME_USER=app_runtime
# REQUIRED
APP_RUNTIME_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: RustFS container now, OSS/S3/R2 later)
# ---------------------------------------------------------------------------
S3_BUCKET=erp-assets
# REQUIRED
S3_ACCESS_KEY=
# REQUIRED
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Envelope encryption + JWT
# ---------------------------------------------------------------------------
KMS_PROVIDER=local_aes
# REQUIRED: 64 hex characters (32 bytes). Rotate together with KMS_KEY_ID.
MASTER_KEK_HEX=
KMS_KEY_ID=local-kek-v1
# REQUIRED: at least 32 chars.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------------------------------------------------------------------------
# Host binding / ports
# ---------------------------------------------------------------------------
# 127.0.0.1 keeps every port off the public internet; put infra/docker/nginx.edge.conf
# (or a cloud LB) in front. Use 0.0.0.0 only on a firewalled host.
PROD_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5433
PGBOUNCER_HOST_PORT=6432
REDIS_HOST_PORT=6379
S3_HOST_PORT=9000
S3_CONSOLE_PORT=9001
BACKEND_HOST_PORT=8000
WEB_HOST_PORT=3000
WIDGET_HOST_PORT=3001

# ---------------------------------------------------------------------------
# Web (Next.js) / BFF
# ---------------------------------------------------------------------------
# Service-to-service URL inside the compose network; do not point this at
# 127.0.0.1 (that would resolve to the web container itself).
BFF_BACKEND_URL=http://backend:8000
# Must stay false in production: mock mode serves fixtures and skips the real API.
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_BACKEND_SSE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# AI providers (optional; leave empty to keep the deterministic tool-only path)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Channels / compliance webhooks (optional — required only for live channels)
# ---------------------------------------------------------------------------
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
TELEGRAM_WEBHOOK_BASE_URL=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=
TRACK17_API_KEY=
TRACK17_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# ---------------------------------------------------------------------------
# Billing (optional)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Image tag override (e.g. a registry tag after `docker compose push`)
# ---------------------------------------------------------------------------
ERP_IMAGE_TAG=prod
